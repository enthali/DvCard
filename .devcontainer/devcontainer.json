{
  "name": "Android Development (Simplified)",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/desktop-lite:1": {
      "password": "vscode",
      "webPort": 6080,
      "vncPort": 5901
    }
  },
  "forwardPorts": [6080, 5037, 8080],
  "portsAttributes": {
    "6080": { "label": "noVNC (Android Studio GUI)" },
    "5037": { "label": "ADB Server" },
    "8080": { "label": "App Development Server" }
  },
  "mounts": [
    // Mount für Android SDK Cache (Performance)
    "source=android-sdk-cache,target=/android-sdk,type=volume",
    // Mount für Gradle Cache (Performance)  
    "source=gradle-cache,target=/home/vscode/.gradle,type=volume",
    // KVM Device für Android Emulator Hardware Acceleration
    "source=/dev/kvm,target=/dev/kvm,type=bind"
  ],
  "runArgs": [
    "--privileged",
    "--device=/dev/kvm:/dev/kvm"
  ],
  "containerEnv": {
    "DISPLAY": ":1",
    "LANG": "en_US.UTF-8",
    "LANGUAGE": "en_US:en",
    "LC_ALL": "en_US.UTF-8",
    "ANDROID_HOME": "/android-sdk",
    "ANDROID_SDK_ROOT": "/android-sdk"
  },
  "postCreateCommand": ".devcontainer/post-create.sh",
  "postStartCommand": "bash .devcontainer/post-start.sh",
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "mathiasfrohlich.Kotlin",
        "ms-vscode.vscode-json"
      ],
      "settings": {
        "java.configuration.runtimes": [
          {
            "name": "JavaSE-21",
            "path": "/usr/lib/jvm/java-21-openjdk-amd64/"
          }
        ],
        "java.compile.nullAnalysis.mode": "automatic",
        "files.defaultLanguage": "en",
        "locale": "en"
      }
    }
  }
}
